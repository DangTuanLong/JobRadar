APP_ENV=development
LOG_LEVEL=INFO

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# JWT verification uses Supabase JWKS endpoint (${SUPABASE_URL}/auth/v1/.well-known/jwks.json)

GEMINI_API_KEY=
# Gemini models, thinking levels & SLA timeouts (auto-fallback to gemini-3.5-flash-lite on 503/429/timeout)
GEMINI_MODEL_EXTRACTION=gemini-4-hydrogen
GEMINI_MODEL_MATCHING=gemini-4-hydrogen
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GEMINI_EXTRACTION_TIMEOUT_SECONDS=45.0
GEMINI_MATCHING_TIMEOUT_SECONDS=60.0
GEMINI_EXTRACTION_THINKING_LEVEL=low
GEMINI_MATCHING_THINKING_LEVEL=medium
GITHUB_TOKEN=
TAVILY_API_KEY=
