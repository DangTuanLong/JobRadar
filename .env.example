APP_ENV=development
LOG_LEVEL=INFO

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# JWT verification uses Supabase JWKS endpoint (${SUPABASE_URL}/auth/v1/.well-known/jwks.json)

GEMINI_API_KEY=
# Default Gemini 4 models (switch to gemini-3.5-flash-lite if higher RPD is needed for batch tests)
GEMINI_MODEL_EXTRACTION=gemini-4-hydrogen
GEMINI_EXTRACTION_THINKING_LEVEL=low
GEMINI_MODEL_MATCHING=gemini-4-hydrogen
GITHUB_TOKEN=
TAVILY_API_KEY=
